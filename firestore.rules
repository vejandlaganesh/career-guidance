rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true; // In production, add auth checks
    }
    match /savedCareers/{userId} {
      allow read, write: if true;
    }
    match /quizAttempts/{userId} {
      allow read, write: if true;
    }
    match /conversations/{userId} {
      allow read, write: if true;
    }
    match /notifications/{userId} {
      allow read, write: if true;
    }
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true; // Admin only in production
    }
  }
}
